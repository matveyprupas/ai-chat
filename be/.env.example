# NestJS
PORT=3000
NODE_ENV=development

# PostgreSQL (docker-compose)
DATABASE_URL=postgresql://aichat:aichat@localhost:5432/aichat?schema=public

# Redis (docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# Tenant UUID used in Redis buffer keys (buffer:{TENANT_ID}:{chatId}).
# Required — set a real UUID in your local be/.env (do not leave blank).
TENANT_ID=00000000-0000-4000-8000-000000000001

# Telegram — one bot for clients + confectioner approvals (polling locally)
TELEGRAM_BOT_TOKEN=

# Optional: confectioner chat id for approval notifications (later)
# TENANT_TELEGRAM_CHAT_ID=

# Google Gemini (Day 3+ — leave empty for scaffold)
# GOOGLE_GENERATIVE_AI_API_KEY=
